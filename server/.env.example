# Copy to .env and adjust.

# Shared-secret token the client must send as "Authorization: Bearer <token>"
AUTH_TOKEN=change-me-to-a-long-random-string

# Where SQLite DB file lives
DB_PATH=./data/meetings.db

# faster-whisper model. RTX 3060 12GB has headroom for "large-v3" alongside a
# quantized 8B LLM, but "medium" is a good faster/cheaper default.
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16

# Ollama server (defaults to same box)
OLLAMA_HOST=http://127.0.0.1:11434
# IMPORTANT: use Ollama's quantized tag, not the raw fp16 HF checkpoint.
# "ollama pull llama3.1:8b" is ~4.7GB (Q4_0) and fits fine in 12GB VRAM
# alongside Whisper. The 16GB fp16 checkpoint you tried to fine-tune earlier
# is a different, much larger artifact than this quantized inference model.
OLLAMA_MODEL=llama3.1:8b
# Proven fallback if llama3.1:8b gives you trouble (gating, VRAM, etc.)
OLLAMA_FALLBACK_MODEL=mistral:7b-instruct

# Where the built web client lives (npm run build in client/, then rsync
# dist/ here). Served automatically if present; API-only if missing.
STATIC_DIR=./client-dist

# Note: host/port/TLS are passed as uvicorn CLI flags (see server/README.md
# and deploy/meetnnote.service), not read from here.
HOST=0.0.0.0
PORT=8443
