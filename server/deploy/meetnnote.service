[Unit]
Description=MeetnNote - AI meeting notes server
After=network.target ollama.service
Wants=ollama.service

[Service]
# Edit these two paths/user if your app or venv live somewhere else.
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/meetnnote/server
EnvironmentFile=/home/YOUR_USERNAME/meetnnote/server/.env
ExecStart=/home/YOUR_USERNAME/meetnnote-env/bin/uvicorn app.main:app --host 0.0.0.0 --port 8443 --ssl-keyfile certs/key.pem --ssl-certfile certs/cert.pem
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
